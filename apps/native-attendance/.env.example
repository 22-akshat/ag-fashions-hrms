# Loaded by babel-plugin react-native-dotenv; values inline into `process.env.EXPO_PUBLIC_*`.
# Keep the same logical keys as apps/mobile-attendance/.env (EXPO_PUBLIC_*).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

EXPO_PUBLIC_DEFAULT_SHOP_ID=

EXPO_PUBLIC_OFFICE_LAT=
EXPO_PUBLIC_OFFICE_LNG=
EXPO_PUBLIC_ALLOWED_RADIUS_METERS=

EXPO_PUBLIC_ATTENDANCE_EDGE_INVOCATION_KEY=

EXPO_PUBLIC_DEV_SKIP_FACE_MATCH=false
EXPO_PUBLIC_ENABLE_LIVENESS=false
EXPO_PUBLIC_FACE_MATCH_THRESHOLD=
EXPO_PUBLIC_LIVENESS_THRESHOLD=
EXPO_PUBLIC_SHARPNESS_THRESHOLD=

# Optional: enforce bundle id / application id match (Android package name).
EXPO_PUBLIC_EXPECTED_APP_ID=
