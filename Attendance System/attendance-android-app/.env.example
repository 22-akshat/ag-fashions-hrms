# Required
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Store geofence: loaded from Supabase `shops` (lat, lng, radius_meters) — same as management app.
# If set, that shop row is used. If omitted, the first shops row (`limit 1`) is used.
EXPO_PUBLIC_DEFAULT_SHOP_ID=

# Optional fallback if the device is offline / shops fetch fails — same numbers you keep in DB.
EXPO_PUBLIC_OFFICE_LAT=
EXPO_PUBLIC_OFFICE_LNG=
EXPO_PUBLIC_ALLOWED_RADIUS_METERS=

# Face (native module — see README). Expo Go: usually set true for testing only.
EXPO_PUBLIC_DEV_SKIP_FACE_MATCH=false
EXPO_PUBLIC_ENABLE_LIVENESS=false
EXPO_PUBLIC_FACE_MATCH_THRESHOLD=
EXPO_PUBLIC_LIVENESS_THRESHOLD=
EXPO_PUBLIC_SHARPNESS_THRESHOLD=
